# Copia este archivo a .env y completa los valores.

# PostgreSQL (prisma.config.ts y lib/server/db.ts arman la conexión con estas variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_base
DB_USER=usuario
DB_PASSWORD=contraseña
# Esquema donde viven las tablas (también se acepta DB_SCHEMA)
DB_SHEMA=centralapp

# Opcional: administrador que crea `npm run db:seed` (por defecto demo@centralapp.com / demo1234)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
